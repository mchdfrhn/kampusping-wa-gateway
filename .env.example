# KampusPing WhatsApp gateway. Copy to .env and fill in real values (never commit .env).

# HTTP API. Must stay on a loopback address; only the backend on the same host calls it.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8095
# Escape hatch for container setups only (the API is then reachable from the network).
GATEWAY_ALLOW_NON_LOOPBACK=false

# Shared secret the backend sends as "Authorization: Bearer <key>" (same value as the backend's
# WA_GATEWAY_API_KEY). At least 16 characters, e.g. `openssl rand -hex 32`.
WA_GATEWAY_API_KEY=change-me-to-a-long-random-key

# Backend webhook for delivery receipts and connection changes, signed with WA_WEBHOOK_SECRET
# (same value as the backend's WA_WEBHOOK_SECRET). At least 16 characters.
# Local dev backend on :8000; production backend on 127.0.0.1:8093.
WA_WEBHOOK_URL=http://127.0.0.1:8000/api/v1/webhooks/whatsapp
WA_WEBHOOK_SECRET=change-me-to-another-long-random-secret
# Retries after the first delivery attempt, and the first retry delay (doubles: 1 s, 2 s, 4 s, ...).
WA_WEBHOOK_RETRIES=5
WA_WEBHOOK_RETRY_BASE_MS=1000
WA_WEBHOOK_TIMEOUT_MS=10000
# Receipts are held at least this long after the send response, so the backend knows the id.
WA_STATUS_DELAY_MS=2000

# Baileys session (credentials). Protect it like a password; back it up.
WA_AUTH_DIR=./auth_state
# Durable client_ref -> provider_message_id store (prevents double sends on retries).
WA_DEDUPE_FILE=./data/sent-refs.json
WA_DEDUPE_TTL_DAYS=14

# Gateway log level (fatal, error, warn, info, debug) and the Baileys library log level
# (silent, fatal, error, warn, info; more verbose levels are refused because they log content).
LOG_LEVEL=info
WA_BAILEYS_LOG_LEVEL=warn
